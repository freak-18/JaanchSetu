# Copy to .env (optional: defaults match docker-compose)
DATABASE_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/jaanchsetu?retryWrites=true&w=majority
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=jaanchsetu-documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
SMTP_HOST=localhost
SMTP_PORT=1025
JWT_SECRET=change-me
# 64 hex chars = 32-byte AES-256 key for files at rest. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FILE_ENC_KEY=5341404b5348492d323032362d44454d4f2d4b45592d4e4f542d464f522d5052
DEMO_MODE=true
# Email: with MAIL_DISABLED=true (the no-Docker default) emails are only recorded (Admin > Email outbox).
# MAIL_DISABLED=false sends through SMTP_HOST/SMTP_PORT. For a real provider also set:
# SMTP_USER=...  SMTP_PASS=...  SMTP_SECURE=true   MAIL_FROM=noreply@your-domain
# Real bank verification (leave empty to use the labelled simulator). See README, "Connecting a bank".
# BANK_API_URL=https://bank.example/verify
# BANK_API_KEY=...
# BANK_API_NAME=Example Bank API
# BANK_API_TIMEOUT_MS=8000
# Address printed in release-order QR codes (the public verification page lives at <PUBLIC_URL>/verify/<order no>).
# PUBLIC_URL=http://localhost:5173
# STORAGE_DRIVER=local   # keep encrypted files on disk instead of MinIO